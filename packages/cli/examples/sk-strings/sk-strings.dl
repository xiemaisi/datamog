# SK combinators, with terms as strings
#
# Combinatory logic gets by with two combinators and one rule each:
#
#   K x y    -> x                (throw the second argument away)
#   S x y z  -> x z (y z)        (hand the third to the other two)
#
# That is enough to encode every computable function, so this program is an
# interpreter for a Turing-complete calculus written in Datalog. The feature
# that makes it possible is *value-producing recursion*: a recursive predicate
# whose columns hold values the rules build, not just values they read. Here
# the values are strings and the builder is `+`.
#
# Terms are in prefix (Polish) notation -- '@' applies, 'S' and 'K' are the
# combinators, and parentheses are unnecessary. `S K K K` is "@@@SKKK". The
# encoding pays off twice: building a term is concatenation, and a subterm's
# extent can be found by counting rather than by matching brackets.
#
# See sk-proof-terms for the same calculus over structured terms.
#
# native/seminaive only: several rules join two recursive atoms (non-linear
# recursion), which the SQL backends reject.

# Every term we know of: the one we start from, plus its subterms and every
# reduct. This is the value-producing cycle -- `t` feeds `step` feeds `t`.
t("@@@SKKK").

# --- Where does a subterm end? ---------------------------------------------
# Walk right from I counting subterms still owed: '@' owes two more, an atom
# settles one. The subterm ends where the debt reaches zero. Stopping at zero
# matters: keep walking and the count would return to zero again further right,
# reporting a span that is two subterms wide.
scan(T, I, I, 1) :- t(T), I in [0 .. 20], I < length(T).
scan(T, I, J + 1, N + 1) :- scan(T, I, J, N), N > 0, T[J] = "@", J < length(T).
scan(T, I, J + 1, N - 1) :- scan(T, I, J, N), N > 0, T[J] <> "@", J < length(T).
span(T, I, J) :- scan(T, I, J, 0).

# An application splits into function and argument: T = @ F X.
decomp(T, F, X) :- t(T), T[0] = "@", span(T, 1, J), F = T[1:J], X = T[J:length(T)].
t(F) :- decomp(_, F, _).
t(X) :- decomp(_, _, X).

# --- The two reduction rules ----------------------------------------------
# K x y -> x. "@@K" is `@ (@ K x) y`, so x starts at 3 and the reduct is a
# slice: no term is built here.
step(T, X) :- t(T), T[0:3] = "@@K", span(T, 3, J), X = T[3:J].

# S x y z -> x z (y z), which in prefix is @@<x><z>@<y><z>. Note z appearing
# twice in the result -- this is the rule that makes terms grow.
step(T, "@@" + X + Z + "@" + Y + Z) :-
  t(T), T[0:4] = "@@@S",
  span(T, 4, J1), X = T[4:J1],
  span(T, J1, J2), Y = T[J1:J2],
  Z = T[J2:length(T)].

# Reduction is a congruence: rewriting either side of an application rewrites
# the whole. Here the recursion through `t` closes.
step(T, "@" + G + X) :- decomp(T, F, X), step(F, G).
step(T, "@" + F + Y) :- decomp(T, F, X), step(X, Y).
t(U) :- step(_, U).

# --- Reduction to a normal form -------------------------------------------
reduces(T, T) :- t(T).
reduces(T, V) :- step(T, U), reduces(U, V).

# S K K is the identity combinator, so S K K K reduces to K in two steps.
?- step(T, U).
output predicate normal_form(U) :- reduces("@@@SKKK", U), not step(U, _).

# Nothing here promises to terminate, and that is the point: a calculus that
# can express every computation expresses every non-terminating one too.
# Datamog does not pretend otherwise. `--warn-finiteness` flags exactly these
# columns ("on a value-producing recursion cycle and may grow without bound"),
# and the interpreters stop at `--max-iterations` with a message naming the
# predicates still producing rows, rather than hanging. A term whose reducts
# cycle back on themselves is no trouble, since Datalog derives a *set* and the
# set closes; a term whose reducts keep growing is what runs away.
