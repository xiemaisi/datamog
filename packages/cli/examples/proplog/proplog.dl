# Proplog: rules as data
#
# Adapted from the `expert_system` example in the SWI-Prolog collection and
# `metainterpreters` in Logtalk's, both of which write Prolog's `solve/1` in
# Prolog. Those are meta-interpreters: they interpret the host language in
# itself. This one is not. The object language is Proplog, propositional Horn
# clauses, which is strictly weaker than the Datalog interpreting it. What
# carries over is the idea: a forward-chaining interpreter whose knowledge
# base is a relation rather than a program, so editing `kb` changes what the
# program concludes with no reparsing.
#
# A clause is `kb(Id, Head, Premises)` with the premises in an array `value`.
# `derived` is the interpreter: a head holds when all of its premises hold.
#
# WHY THE PREFIX COUNTER. The natural way to say "all premises hold" is to
# find a premise that does not and rule the clause out:
#
#   premise(Id, A) :- kb(Id, _, B), array_element(B, _, V), A = as_string(V).
#   unmet(Id)      :- premise(Id, A), not derived(A).
#   derived(H)     :- kb(Id, H, _), not unmet(Id).
#
# That is the double-negation trick from `relational-division`, and here it
# does not work: `derived` now depends on `unmet`, which depends negatively
# on `derived`, so negation sits inside a recursive cycle and the program is
# not stratifiable. Counting the met premises with an aggregate and comparing
# against the total fails the same way.
#
# So the interpreter walks the premise array positionally instead.
# `body_derived(Clause, N)` means the first N premises hold; it starts at 0
# and extends one element at a time, and a head is derived once the prefix
# reaches `length(B)`. Positive recursion and arithmetic only, and no bound
# on how many premises a clause may have.
#
# `derived` and `body_derived` are mutually recursive, and the step rule has
# two atoms from that cycle in its body, so this is non-linear recursion and
# runs on the in-memory backends only.

kb(1, "rained", []).
kb(2, "cold", []).
kb(3, "driving", []).
kb(4, "wet_grass", ["rained"]).
kb(5, "slippery", ["wet_grass", "cold"]).
kb(6, "accident", ["slippery", "driving", "fast"]).
kb(7, "insurance_claim", ["accident"]).

body_atom_derived(Clause, N) :- kb(Clause, _, B), array_element(B, N, V), A = as_string(V), derived(A).

body_derived(Clause, 0) :- kb(Clause, _, _).
body_derived(Clause, N + 1) :- body_derived(Clause, N), body_atom_derived(Clause, N).

derived(H) :- kb(Clause, H, B), body_derived(Clause, length(B)).

?- derived(Conclusion).

# What the knowledge base mentions but cannot conclude, and why. "fast" is
# never a head, so it is an open question; "accident" needs it, and
# "insurance_claim" needs "accident".
mentioned(A) :- kb(_, A, _).
mentioned(A) :- kb(_, _, B), array_element(B, _, V), A = as_string(V).

output predicate not_derived(A) :- mentioned(A), not derived(A).
output predicate unsupported(A) :- mentioned(A), not kb_head(A).
kb_head(A) :- kb(_, A, _).
