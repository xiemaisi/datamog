# A meta-interpreter: rules as data
#
# Adapted from the `expert_system` example in the SWI-Prolog collection and
# `metainterpreters` in Logtalk's, both of which write Prolog's `solve/1` in
# Prolog. This is the Datalog counterpart: a forward-chaining interpreter for
# propositional Horn clauses whose knowledge base is a relation, not a
# program. Editing `kb` changes what the program concludes with no reparsing.
#
# A clause is `kb(Id, Head, Premises)` with the premises in an array `value`.
# `derived` is the interpreter: a head holds when all of its premises hold.
#
# WHY THE ARITY LADDER. The natural way to say "all premises hold" is to
# find a premise that does not and rule the clause out:
#
#   premise(Id, A) :- kb(Id, _, B), array_element(B, _, V), A = as_string(V).
#   unmet(Id)      :- premise(Id, A), not derived(A).
#   derived(H)     :- kb(Id, H, _), not unmet(Id).
#
# That is the double-negation trick from `relational-division`, and here it
# does not work: `derived` now depends on `unmet`, which depends negatively
# on `derived`, so negation sits inside a recursive cycle and the program is
# not stratifiable. Counting the met premises and comparing against the total
# fails the same way, because it recurses through an aggregate. So the
# interpreter matches premises positionally instead, one rule per body
# length, and only handles clauses up to the longest ladder rung written out.
# That is the honest cost of a meta-interpreter without recursion through
# negation.
#
# Two or three `derived` atoms in one rule body makes this non-linear
# recursion, so it runs on the in-memory backends only.

kb(1, "rained", []).
kb(2, "cold", []).
kb(3, "driving", []).
kb(4, "wet_grass", ["rained"]).
kb(5, "slippery", ["wet_grass", "cold"]).
kb(6, "accident", ["slippery", "driving", "fast"]).
kb(7, "insurance_claim", ["accident"]).

derived(H) :- kb(_, H, B), length(B) == 0.

derived(H) :- kb(_, H, B), length(B) == 1,
  A0 = as_string(B[0]), derived(A0).

derived(H) :- kb(_, H, B), length(B) == 2,
  A0 = as_string(B[0]), A1 = as_string(B[1]),
  derived(A0), derived(A1).

derived(H) :- kb(_, H, B), length(B) == 3,
  A0 = as_string(B[0]), A1 = as_string(B[1]), A2 = as_string(B[2]),
  derived(A0), derived(A1), derived(A2).

?- derived(Conclusion).

# What the knowledge base mentions but cannot conclude, and why. "fast" is
# never a head, so it is an open question; "accident" needs it, and
# "insurance_claim" needs "accident".
mentioned(A) :- kb(_, A, _).
mentioned(A) :- kb(_, _, B), array_element(B, _, V), A = as_string(V).

output predicate not_derived(A) :- mentioned(A), not derived(A).
output predicate unsupported(A) :- mentioned(A), not kb_head(A).
kb_head(A) :- kb(_, A, _).
