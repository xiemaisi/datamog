# The relational operations, written as rules
#
# Adapted from `relop.dl` in the Datalog Educational System (DES) by
# Fernando Saenz-Perez.
#
# Every operator of the relational algebra has a one-rule Datalog spelling.
# Projection is dropping a variable, selection is a filter, product is a
# comma, join is a shared variable, union is a second rule, and difference
# is `not`. Only the outer joins need more than one rule, because they have
# to pad the unmatched side with NULL.
#
# See doc/comparison.md for how Datamog relates to SQL more broadly.

a("a1"). a("a2"). a("a3").
b("b1"). b("b2"). b("a1").
c("a1", "b2"). c("a1", "a1"). c("a2", "b2").

# pi_X(c), projection: name only the columns you keep.
projection(X) :- c(X, _).

# sigma_{X = a2}(a), selection: a filter in the body.
selection(X) :- a(X), X = "a2".

# a x b, Cartesian product: two atoms with nothing in common.
cartesian(X, Y) :- a(X), b(Y).

# a |x| b, natural join: the shared variable *is* the join condition.
inner_join(X) :- a(X), b(X).

# a U b, union: two rules for one predicate.
union(X) :- a(X).
union(X) :- b(X).

# a - b, difference: negation, which needs `a(X)` first to bind X.
difference(X) :- a(X), not b(X).

# a =|x| b, left outer join: the matches, then the unmatched rows padded
# with NULL. Y gets its type from the first rule; `null` flows through the
# second at runtime.
left_join(X, Y) :- a(X), b(Y), X = Y.
left_join(X, null) :- a(X), not b(X).

# a |x|= b, right outer join: the mirror image.
right_join(X, Y) :- a(X), b(Y), X = Y.
right_join(null, Y) :- b(Y), not a(Y).

# a =|x|= b, full outer join: both paddings on top of the matches.
full_join(X, Y) :- left_join(X, Y).
full_join(X, Y) :- right_join(X, Y).

?- full_join(X, Y).

output predicate proj(X) :- projection(X).
output predicate sel(X) :- selection(X).
output predicate prod(X, Y) :- cartesian(X, Y).
output predicate join(X) :- inner_join(X).
output predicate uni(X) :- union(X).
output predicate diff(X) :- difference(X).
output predicate lj(X, Y) :- left_join(X, Y).
output predicate rj(X, Y) :- right_join(X, Y).
