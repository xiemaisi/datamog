# Boolean operators: && (logical and), || (logical or), ! (logical not).
# Operands and results are boolean, and there is no third truth value.
#
# A `null` is no truth value, so a connective handed one (from a
# `boolean?` column, the only way one gets there) has **no value**
# unless the other operand already decides the answer. With `B` null,
# `!B` and `B && true` have no value, while `B && false` is still
# `false` and `B || true` is still `true`, by dominance. Same on every
# backend (spec §5.4).
#
# A boolean expression in a body position is a *filter*: the rule only
# fires when the expression is `true`. An expression with no value
# does not hold, so its row goes, and so does a row whose filter is
# `null`-valued.

user("alice", true,  true ).
user("bob",   false, true ).
user("carol", true,  false).
user("dave",  false, false).

admin_or_active(N) :- user(N, A, I), A || I.
output predicate both_admin_and_active(N) :- user(N, A, I), A && I.

# Logical not. `!(A && I)` is "not both admin and active" — locked
# out of admin actions even though they may be active users.
output predicate locked(N) :- user(N, A, I), !(A && I).

# Boolean columns also round-trip cleanly across backends — the
# executor coerces SQLite's 0/1 boolean storage back into JS
# true/false at the result boundary, so the row shape matches the
# native evaluator's exactly.
status(N, A && I, A || I) :- user(N, A, I).

# Project the status relation as a named result.
output predicate user_status(N, BothAdminActive, AnyPriv) :- status(N, BothAdminActive, AnyPriv).

?- admin_or_active(N).
