# Primitive conversions: parse a string into integer / float / boolean, and
# format primitive values back to a string.
#
# Demonstrates the strict canonical-form parsing rule: leading zeros,
# non-numeric junk, and out-of-range cases are all rejected rather than
# implicitly truncated or coerced. Round-trip examples in the `formatted`
# predicate exercise the inverse direction.
#
# Read the output for what is *missing*. A failed parse has no value, so its
# whole row is absent rather than present with a NULL in the parsed column:
# `parsed_int` has a row for every input it could parse and none for the rest.
# That is the point worth taking away, and the thing to watch for in your own
# programs, since a rule that quietly derives fewer tuples than its input
# suggests looks the same as one that derives none for a different reason.
#
# To see which inputs were rejected, ask for the ones whose conversion has no
# value. `defined` is the readable spelling:
#
#     rejected(R) :- inputs("int", R), not defined(to_integer(R)).
#
# `not (e = e)` says the same thing without the builtin, an equality needing both
# sides to have a value:
#
#     rejected(R) :- inputs("int", R), not (to_integer(R) = to_integer(R)).

input predicate inputs(kind: string, raw: string).
input predicate formats(name: string, i: integer, r: float, b: boolean).

# Parse the string into the target type. A failed parse has no value, so the
# conjunct does not hold and the row is not derived at all.
parsed_int(R, N)  :- inputs("int",  R), N = to_integer(R).
output predicate parsed_float(R, N) :- inputs("float", R), N = to_float(R).
output predicate parsed_bool(R, B) :- inputs("bool", R), B = to_boolean(R).

# Format primitive values back to strings. The native and Postgres
# backends render integer-valued floats without a `.0` suffix
# (`String(1.0) = '1'`); SQLite renders them as `'1.0'`. The example
# data avoids that case by using floats with non-zero fractional
# parts, so the expected output is identical across backends.
output predicate formatted(Name, S_INT, S_REAL, S_BOOL) :-
    formats(Name, I, R, B),
    S_INT  = to_string(I),
    S_REAL = to_string(R),
    S_BOOL = to_string(B).

# Lift each primitive into a value. Auto-lift fires anywhere a value
# slot meets a primitive (atom args, equalities, IDB column
# unification), but when no surrounding context demands a value the
# `[X][0]` idiom produces one explicitly: an array literal is always
# a value, and subscripting it returns the lifted element. Round-
# tripping back through the matching `as_*` recovers the original
# primitive — exercised by the `lifted_round_trip` rule below.
output predicate lifted(Name, JI, JR, JB, JS) :-
    formats(Name, I, R, B),
    JI = [I][0],
    JR = [R][0],
    JB = [B][0],
    JS = [Name][0].

output predicate lifted_round_trip(Name, I, R, B, S) :-
    lifted(Name, JI, JR, JB, JS),
    I = as_integer(JI),
    R = as_float(JR),
    B = as_boolean(JB),
    S = as_string(JS).

?- parsed_int(R, N).
