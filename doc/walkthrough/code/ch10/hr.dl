# Tutorial, chapter 10 — a small HR-style schema.

input predicate employee(id: integer, name: string, salary: integer).
input predicate in_department(emp_id: integer, dept_id: integer).
input predicate manages(manager: integer, report: integer).

# --- Keys, enforced ---------------------------------------------------------
# `employee.id` is the schema's primary key. Two rows can only share an id if
# some other column differs, so that is exactly what to look for.
error predicate duplicate_employee_id(Id) :-
  employee(Id, N1, S1), employee(Id, N2, S2), N1 <> N2 || S1 <> S2.

# `in_department.emp_id` and both columns of `manages` are foreign keys into
# `employee`. Every reference must resolve.
error predicate unknown_department_member(EmpId) :-
  in_department(EmpId, _), not employee(EmpId, _, _).

error predicate unknown_manages_party(Who) :-
  manages(Who, _), not employee(Who, _, _).
error predicate unknown_manages_party(Who) :-
  manages(_, Who), not employee(Who, _, _).

# Nobody manages themselves. A one-off assertion, so it needs no name.
!- manages(M, M).

# Anyone who manages someone.
is_manager(M) :- manages(M, _).

# Transitively: employees who report up (directly or indirectly)
# to a given manager.
reports_to(R, M) :- manages(M, R).
reports_to(R, M) :- manages(M, X), reports_to(R, X).

# An individual contributor has no reports.
ic(E) :- employee(E, _, _), not is_manager(E).

# Head count per department.
output predicate head_count(Dept, count(E)) :- in_department(E, Dept).

# A "big team" manager is one who directly or indirectly manages
# at least 2 reports. Two strata: compute report_count first,
# then filter.
report_count(M, count(R)) :- reports_to(R, M).
output predicate big_team_manager(M) :- report_count(M, C), C >= 2.

?- ic(E).
